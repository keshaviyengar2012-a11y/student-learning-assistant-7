# Copy this file to .env and fill it in. Never upload .env to GitHub.
ANTHROPIC_API_KEY=your-key-from-console.anthropic.com

# Optional
MODEL=claude-sonnet-5-5
QUICK_MODEL=claude-haiku-5-5
PER_STUDENT_PER_HOUR=40
# HOST and PORT are for the local server only; Vercel ignores them
HOST=127.0.0.1
PORT=8000
# Other websites allowed to use /api/claude, comma separated (not needed normally)
ALLOWED_ORIGINS=
