# Copy this file to .env and fill it in. Never upload .env to GitHub.
# Get a key at aistudio.google.com → Get API key
GEMINI_API_KEY=your-key-from-aistudio.google.com

# Optional
MODEL=gemini-3.8-flash
QUICK_MODEL=gemini-3.5-flash-lite
# How much Gemini thinks before answering: minimal, low, medium or high
THINKING=low
PER_STUDENT_PER_HOUR=40
# HOST and PORT are for the local server only; Vercel ignores them
HOST=127.0.0.1
PORT=8000
# Other websites allowed to use /api/tutor, comma separated (not needed normally)
ALLOWED_ORIGINS=
